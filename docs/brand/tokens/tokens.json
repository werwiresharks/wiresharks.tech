    "radii_px": [
      3,
      6,
      8
    ],
    "header_height_px": 76,
    "header_scrolled": {
      "inset_px": 12,
      "height_px": 56,
      "inset_px_mobile": 8,
      "height_px_mobile": 52,
      "radius": "--radius-lg",
      "max_width_px": 1200
    },
    "breakpoints_px": [
      600,
      768,
      1024
    ],
    "template_step_px": [
      8,
      16,
      24,
      32,
      48,
      72,
      96
    ]
  },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease_in_out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "durations_ms": [
      160,
      320,
      700
    ],
    "reveal": "800ms opacity + 6px blur + 14px lift on the same ease; display type enters word by word",
    "motifs": [
      "particle orb",
      "claw-tear reveal",
      "swarm split and combine",
      "red strike line"
    ],
    "hover": "gated to (hover: hover)",
    "reduced_motion": "prefers-reduced-motion removes reveals and smooth scroll; the Raptor Particle Engine holds its particles still"
  },
  "logo": {
    "$comment": "Geometry of the live header mark.",
    "mark": {
      "viewBox": "34 32 132 94",
      "header_size_px": [
        29,
        21
      ],
      "node": "one red square node at the stroke's end"
    },
    "lockup": "WIRESHARKS wordmark plus the single red node mark",
    "clear_space": "half the mark height on all sides",
    "min_width_px": {
      "mark_alone": 16,
      "lockup": 96
    }
  },
