  "type": {
    "families": {
      "sans": {
        "name": "Geist",
        "weights": [
          400,
          500,
          600
        ],
        "license": "SIL OFL 1.1",
        "served_version": "1.800"
      },
      "mono": {
        "name": "Geist Mono",
        "weights": [
          400,
          500
        ],
        "license": "SIL OFL 1.1",
        "served_version": "1.701"
      }
    },
    "scale": {
      "display": {
        "token": "--fs-display",
        "weight": 400,
        "tracking": "-0.055em to -0.06em",
        "line_height": "0.92 (hero) to 1 (closing)"
      },
      "mega": {
        "token": "--fs-mega",
        "weight": 400,
        "use": "Closing countdown (mono) and footer wordmark"
      },
      "product": {
        "token": "--fs-product",
        "weight": 400,
        "use": "Product names in product blocks"
      },
      "h1": {
        "token": "--fs-h1",
        "weight": 400
      },
      "h2": {
        "token": "--fs-h2",
        "weight": 500,
        "tracking": "-0.04em"
      },
      "h3": {
        "token": "--fs-h3",
        "weight": 500
      },
      "lead": {
        "token": "--fs-lead",
        "weight": 400
      },
      "body": {
        "token": "--fs-body",
        "weight": 400
      },
      "ui": {
        "token": "--fs-ui",
        "weight": 500,
        "tracking": "-0.02em",
        "use": "Navigation and CTAs"
      },
      "small": {
        "token": "--fs-small",
        "weight": 400
      },
      "mono": {
        "token": "--fs-mono",
        "family": "mono",
        "weight": 400,
        "use": "Specs, readouts, code"
      },
      "label": {
        "token": "--fs-label",
        "family": "mono",
        "weight": 400,
        "transform": "uppercase",
        "tracking": "0.08em",
        "line_height": 1.4
      },
      "micro": {
        "token": "--fs-micro",
        "use": "12px text floor; nothing smaller"
      }
    },
    "numerals": "tabular (font-variant-numeric: tabular-nums) for counts, specs and the countdown",
    "wordmark": {
      "size_px": 20,
      "size_px_mobile": 19,
      "tracking": "-0.045em",
      "wire_weight": 600,
      "sharks_weight": 400
    },
    "cta": {
      "height_px": 48,
      "size": "--fs-ui",
      "weight": 500,
      "gap_px": 12,
      "radius": "--radius"
    },
    "document_fallbacks": {
      "sans": "Geist, Helvetica Neue, Arial, sans-serif",
      "mono": "Geist Mono, Menlo, Consolas, monospace"
    }
  },
  "layout": {
