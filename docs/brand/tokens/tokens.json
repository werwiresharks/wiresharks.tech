{
  "$comment": "Wiresharks design tokens, snapshot 2026-10-19. css.* equals the live src/styles.css :root, .tone-soft and .tone-dark blocks; tools/check.mjs enforces it. Roles and pairings describe how the site uses them.",
  "version": "2.0.0",
  "status": "ratified",
  "source": {
    "live": "https://wiresharks.tech/",
    "stylesheet": "src/styles.css",
    "snapshot": "2026-10-19"
  },
  "css": {
    "root": {
      "--red": "#e5251b",
      "--red-strong": "#c01812",
      "--red-text": "#c41f1f",
      "--red-tint": "rgba(229, 37, 27, 0.1)",
      "--accent": "var(--red)",
      "--charcoal": "#111214",
      "--charcoal-2": "#1a1b1e",
      "--white": "#ffffff",
      "--soft": "#f5f5f2",
      "--bg": "var(--white)",
      "--fg": "#111214",
      "--fg-2": "#3a3a3a",
      "--muted": "#6b6b6b",
      "--muted-2": "#737371",
      "--line": "rgba(128, 128, 128, 0.2)",
      "--line-strong": "rgba(17, 18, 20, 0.16)",
      "--panel-bg": "#ffffff",
      "--panel-bar": "#fafaf9",
      "--panel-shadow": "0 1px 0 rgba(17, 18, 20, 0.03), 0 28px 56px -32px rgba(17, 18, 20, 0.22)",
      "--ok": "#1f7a45",
      "--run": "#c01812",
      "--review": "#9a6b1f",
      "--link-accent": "var(--red)",
      "--section-depth": "none",
      "--glass-bg": "rgba(255, 255, 255, 0.72)",
      "--glass-blur": "18px",
      "--glass-border": "rgba(17, 18, 20, 0.08)",
      "--ink": "var(--fg)",
      "--bronze-deep": "var(--red)",
      "--sans": "\"Geist\", ui-sans-serif, system-ui, -apple-system, sans-serif",
      "--mono": "\"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "--fs-mega": "clamp(4rem, 13vw, 12rem)",
      "--fs-display": "clamp(3rem, 6vw + 0.75rem, 7.5rem)",
      "--fs-h1": "clamp(2.75rem, 5.6vw, 5.5rem)",
      "--fs-h2": "clamp(2rem, 3.8vw, 3.5rem)",
      "--fs-h3": "clamp(1.5rem, 2.1vw, 1.875rem)",
      "--fs-product": "clamp(3.5rem, 8.4vw, 7.75rem)",
      "--fs-stat": "clamp(2.25rem, 3.6vw, 3.5rem)",
      "--fs-lead": "clamp(1.0625rem, 1.25vw, 1.25rem)",
      "--fs-body": "1rem",
      "--fs-ui": "0.9375rem",
      "--fs-mono": "0.8125rem",
      "--fs-small": "0.875rem",
      "--fs-micro": "0.75rem",
      "--fs-label": "0.75rem",
      "--w-display": "400",
      "--w-h": "500",
      "--w-ui": "500",
      "--tr-display": "-0.055em",
      "--tr-tight": "-0.04em",
      "--tr-ui": "-0.02em",
      "--tr-label": "0.08em",
      "--pad": "clamp(20px, 4.4vw, 72px)",
      "--maxw": "1280px",
      "--section-y": "clamp(96px, 11vw, 160px)",
      "--head-gap": "clamp(56px, 7vw, 96px)",
      "--header-height": "76px",
      "--radius-sm": "3px",
      "--radius": "6px",
      "--radius-lg": "8px",
      "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "--ease-io": "cubic-bezier(0.65, 0, 0.35, 1)",
      "--dur-1": "160ms",
      "--dur-2": "320ms",
      "--dur-3": "700ms",
      "--ease": "var(--ease-out)",
      "--fast": "var(--dur-1)",
      "--base": "var(--dur-2)"
    },
    "tone-soft": {
      "--bg": "var(--soft)",
      "--muted": "#666664",
      "--muted-2": "#6e6e6b",
      "--glass-bg": "rgba(245, 245, 242, 0.72)"
    },
    "tone-dark": {
      "--bg": "var(--charcoal)",
      "--fg": "#f3f3f1",
      "--fg-2": "#d4d4d2",
      "--ink": "var(--fg-2)",
      "--muted": "#9b9b98",
      "--muted-2": "#86867f",
      "--line": "rgba(255, 255, 255, 0.11)",
      "--line-strong": "rgba(255, 255, 255, 0.22)",
      "--panel-bg": "linear-gradient(180deg, #1c1d20, #141517)",
      "--panel-bar": "#1d1e21",
      "--panel-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 40px 80px -40px #000, 0 0 120px -50px rgba(229, 37, 27, 0.22)",
      "--ok": "#5fbf7f",
      "--run": "#ff6a60",
      "--review": "#d2b07a",
      "--red-text": "#ff5a52",
      "--red-tint": "rgba(229, 37, 27, 0.16)",
      "--section-depth": "radial-gradient(90% 60% at 85% -5%, #1e1f23, transparent 70%), radial-gradient(60% 55% at 8% 105%, rgba(229, 37, 27, 0.07), transparent 70%)",
      "--glass-bg": "rgba(20, 21, 23, 0.68)",
      "--glass-border": "rgba(255, 255, 255, 0.1)"
    }
  },
  "observed_exceptions": {
    "$comment": "Colours outside the css tokens. Kept with their files, not promoted to the palette.",
    "small_size_icon_assets": {
      "stroke": "#181a1b",
      "square": "#d52b24",
      "files": [
        "favicon.svg",
        "wiresharks-logo.png"
      ]
    }
  },
  "roles": {
    "$comment": "Value = the css token name above. Tones that re-point a token are noted in css.tone-*.",
    "canvas": {
      "token": "--bg",
      "light": "--white",
      "soft": "--soft",
      "dark": "--charcoal",
      "use": "Page, section or slide background"
    },
    "text": {
      "token": "--fg",
      "use": "Headings and body"
    },
    "text-secondary": {
      "token": "--fg-2",
      "use": "Supporting paragraphs"
    },
    "text-muted": {
      "token": "--muted",
      "use": "Labels, captions, metadata"
    },
    "text-muted-2": {
      "token": "--muted-2",
      "use": "Quieter metadata; body-safe on every canvas"
    },
    "accent": {
      "token": "--red",
      "use": "The one accent. Logo node, arrows, live marks, strike lines, focus ring. Brand and refusal only"
    },
    "accent-strong": {
      "token": "--red-strong",
      "use": "Pressed and running states on light canvases"
    },
    "accent-text": {
      "token": "--red-text",
      "use": "Red text at any size; the dark tone swaps it to #ff5a52"
    },
    "accent-tint": {
      "token": "--red-tint",
      "use": "Highlight behind emphasised display words"
    },
    "panel": {
      "token": "--panel-bg",
      "use": "Instrument panels: task graphs, consoles, registries"
    },
    "panel-bar": {
      "token": "--panel-bar",
      "use": "Panel title bar"
    },
    "divider": {
      "token": "--line",
      "use": "Hairlines"
    },
    "divider-strong": {
      "token": "--line-strong",
      "use": "Emphasis rules and outlines"
    },
    "glass": {
      "token": "--glass-bg",
      "use": "Scrolled header bar, with --glass-blur and --glass-border"
    },
    "status-ok": {
      "token": "--ok",
      "use": "Done, always with a status word"
    },
    "status-run": {
      "token": "--run",
      "use": "Running, always with a status word"
    },
    "status-review": {
      "token": "--review",
      "use": "In review, always with a status word"
    }
  },
  "pairings": {
